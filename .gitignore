# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build output
/.next/
/out/
/build
/dist

# Testing
/coverage
/playwright-report
/test-results
/blob-report
/playwright/.cache

# Environment
# Secrets are never committed, but `.env.example` documents every optional
# variable and is the first file a new contributor reads — so it must stay.
.env
.env.*
!.env.example

# Editor & OS
.DS_Store
.idea
.vscode
.claude
*.pem

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Security hardening: secret-shaped files, none currently present
*.key
credentials*.json
service-account*.json
*.log
*.sqlite
*.db
