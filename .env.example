# ---------------------------------------------------------------------------
# GitBrain configuration
#
# EVERY variable here is optional. GitBrain runs with an empty .env file:
# analysis, the knowledge base, the module graph, search and chat all work
# with no keys and no accounts. Each block below turns on an enhancement.
# ---------------------------------------------------------------------------


# --- GitHub -----------------------------------------------------------------
# Unauthenticated requests to the GitHub API are limited to 60/hour per IP.
# A token raises that to 5,000/hour. Repository archives are downloaded from
# codeload.github.com, which is not rate limited, so this only affects
# metadata (default branch, description, stars).
#
# Create one at https://github.com/settings/tokens with NO scopes — public
# repository metadata needs no permissions.
GITHUB_TOKEN=


# --- AI (OpenRouter) --------------------------------------------------------
# Without a key, chat and the knowledge base are answered by GitBrain's local
# reasoner: retrieval over the real analysis, with citations, at zero cost.
# With a key, an LLM explains those same computed facts more fluently.
#
# The model never sees the raw repository — only GitBrain's structured
# analysis plus the specific code chunks retrieved for the question.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet


# --- Persistence (Supabase) -------------------------------------------------
# Without these, analyses live in a bounded in-memory LRU and are lost on
# restart — fine for local use, wrong for a shared deployment.
#
# Apply supabase/migrations/0001_init.sql to create the schema.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=


# --- Accounts (Clerk) -------------------------------------------------------
# Without these, GitBrain is anonymous: every analysis is public and shareable
# by URL. With them, analyses are owned by the user who ran them.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=


# --- Rate limiting ----------------------------------------------------------
# Defaults for the general limiter. The /api/analyze route uses a tighter
# limit of its own because an analysis is far more expensive than a search.
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000


# --- Deployment -------------------------------------------------------------
# Used for absolute URLs in Open Graph metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# --- Testing ----------------------------------------------------------------
# Port the Playwright suite builds and serves the app on. Change it if 3210 is
# already taken on your machine.
PLAYWRIGHT_PORT=3210
